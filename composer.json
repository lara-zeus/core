{
    "name": "lara-zeus/core",
    "description": "the core for zeus packages",
    "keywords": [
        "laravel",
        "lara-zeus",
        "form",
        "core",
        "contact"
    ],
    "homepage": "https://larazeus.com",
    "support": {
        "issues": "https://github.com/lara-zeus/core/issues",
        "source": "https://github.com/lara-zeus/core"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "php coder",
            "email": "info@larazeus.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "lara-zeus/laravel-seo": "*",
        "lara-zeus/spatie-translatable": "*",
        "filament/filament": "*"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.5",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "LaraZeus\\Core\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraZeus\\Core\\Tests\\": "tests"
        }
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "test:pest": "vendor/bin/pest --parallel",
        "test:phpstan": "vendor/bin/phpstan analyse",
        "test": [
            "@test:pest",
            "@test:phpstan"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "extra": {
        "laravel": {
            "providers": [
                "LaraZeus\\Core\\CoreServiceProvider"
            ],
            "aliases": {
                "Core": "LaraZeus\\Core\\CoreFacade"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../filament/packages/*"
        }
    ]
}
